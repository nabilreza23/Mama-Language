# 1. Testing Functions and Scope
Mama do addNumbers(a, b):
    Mama keep result = a + b
    Mama give result

Mama keep sum = Mama call addNumbers(20, 30)
Mama say 'Sum from Function:'
Mama say sum

# 2. Testing Lists & Arrays
Mama keep numbers = [10, 20, 30]
Mama say 'My List:'
Mama say numbers

# 3. Testing Logic Operators (AND / OR)
Mama keep age = 22
Mama keep status = 'active'

Mama check age >= 18 and status == 'active':
    Mama say 'User is Verified Mama!'
otherwise:
    Mama say 'Access Denied!'

# 4. Testing Try-Catch Block
Mama try:
    Mama say 'Trying risky action...'
    Mama keep x = 10 / 0
Mama catch:
    Mama say 'Caught an error safely without crashing!'
